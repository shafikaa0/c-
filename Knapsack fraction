#include <bits/stdc++.h>
using namespace std;
int main() {
    int totalItems, bagCapacity;
    cin >> totalItems >> bagCapacity;
    vector<pair<int, int>> item(totalItems);
    for (int i = 0; i < totalItems; i++) {
        cin >> item[i].first >> item[i].second;
    }
   double totalWeight = 0, totalValue = 0;
    sort(item.begin(), item.end(), [](auto a, auto b) {
        return (double)b.second / b.first > (double)a.second / a.first;
    });
   for (int i = 0; i < totalItems; i++) {
        int weight = item[i].first;
        int value = item[i].second;
        if (totalWeight + weight <= bagCapacity) {
            totalWeight = totalWeight + weight;
            totalValue = totalValue + value;        }
        else {
            double remainingWeight = bagCapacity - totalWeight;
            totalValue = totalValue + remainingWeight * ((double)value / weight);
            break;       }    }
    cout << fixed << setprecision(2) << totalValue;
    return 0;}
